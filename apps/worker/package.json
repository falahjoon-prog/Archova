{
  "name": "@archova/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node dist/main.js",
    "build": "node build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit --passWithNoTests",
    "test:integration": "vitest run test/integration",
    "dev:ai": "tsx watch --env-file-if-exists=.env src/ai.ts",
    "start:ai": "node dist/ai.js"
  },
  "dependencies": {
    "@archova/compose": "workspace:*",
    "@archova/contracts": "workspace:*",
    "@archova/domain": "workspace:*",
    "@archova/kernel": "workspace:*",
    "@archova/mod-access": "workspace:*",
    "@archova/mod-ai": "workspace:*",
    "@archova/mod-backoffice": "workspace:*",
    "@archova/mod-billing": "workspace:*",
    "@archova/mod-files": "workspace:*",
    "@archova/mod-integrations": "workspace:*",
    "@archova/mod-sync": "workspace:*",
    "@aws-sdk/client-sesv2": "^3.900.0",
    "bullmq": "^5.58.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.8.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@archova/config-eslint": "workspace:*",
    "@archova/config-ts": "workspace:*",
    "@archova/testing": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
