# Local development. Copy to .env. Never commit real secrets.
NODE_ENV=development
API_PORT=4000
API_DATABASE_URL=postgres://app_rw:app_rw@localhost:5432/archova
API_REDIS_URL=redis://localhost:6379
# Browser origin(s) served by apps/web; cookie auth only (ADR-0004).
API_APP_ORIGINS=http://localhost:3000
# Hosts for mobile / public API; bearer auth only.
API_PUBLIC_HOSTS=localhost:4000
# The web dev server proxies /v1 to the API and sets X-Forwarded-Host.
API_TRUST_PROXY=true
API_WEB_SIGN_IN_URL=http://localhost:3000/login
# memory | s3 (MinIO locally via docker compose)
API_FILES_STORE=s3
API_FILES_BUCKET=archova-local-files
API_FILES_REGION=ap-southeast-2
API_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Nova (ai/02). `fake` needs no AWS credentials; `bedrock` needs Australian model ids (X25), e.g. `au.` profiles.
API_AI_PROVIDER=fake
# API_AI_REGION=ap-southeast-2
# API_AI_MODEL_FAST=
# API_AI_MODEL_STANDARD=
# API_AI_MODEL_ADVANCED=
# API_AI_MODEL_EMBEDDING=amazon.titan-embed-text-v2:0
