{
  "name": "@archova/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "node build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit --passWithNoTests",
    "test:integration": "vitest run test/integration",
    "staff:seed": "tsx --env-file-if-exists=.env src/seed-staff.ts"
  },
  "dependencies": {
    "@archova/compose": "workspace:*",
    "@archova/contracts": "workspace:*",
    "@archova/domain": "workspace:*",
    "@archova/kernel": "workspace:*",
    "@archova/mod-access": "workspace:*",
    "@archova/mod-ai": "workspace:*",
    "@archova/mod-backoffice": "workspace:*",
    "@archova/mod-billing": "workspace:*",
    "@archova/mod-defects": "workspace:*",
    "@archova/mod-diary": "workspace:*",
    "@archova/mod-documents": "workspace:*",
    "@archova/mod-estimating": "workspace:*",
    "@archova/mod-integrations": "workspace:*",
    "@archova/mod-files": "workspace:*",
    "@archova/mod-identity": "workspace:*",
    "@archova/mod-platform": "workspace:*",
    "@archova/mod-rfis": "workspace:*",
    "@archova/mod-scheduling": "workspace:*",
    "@archova/mod-sync": "workspace:*",
    "@archova/mod-workforce": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@archova/ai-prompts": "workspace:*",
    "@archova/config-eslint": "workspace:*",
    "@archova/config-ts": "workspace:*",
    "@archova/testing": "workspace:*",
    "@archova/time": "workspace:*",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "ioredis": "^5.8.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
