# Copy to terraform.tfvars (git-ignored). docs/infrastructure/10-linode-option.md lists where each value comes from.
admin_ssh_keys        = ["ssh-ed25519 AAAA... jeff", "ssh-ed25519 AAAA... deploy-pipeline"]
admin_cidrs           = ["203.0.113.10/32"]
aws_account_id        = "111111111111"
roles_anywhere_ca_pem = <<-PEM
  -----BEGIN CERTIFICATE-----
  ...
  -----END CERTIFICATE-----
PEM
# tls_certificate and tls_private_key: pass as TF_VAR_tls_certificate / TF_VAR_tls_private_key, never in a file.
