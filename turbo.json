{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test": {
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": [
        "TEST_DB_ADMIN_URL",
        "TEST_DB_NAME",
        "TEST_REDIS_URL",
        "DB_HOST",
        "DB_PORT"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
